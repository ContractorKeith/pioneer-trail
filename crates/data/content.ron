        (id: "wheel_aftermath", text: "The repaired wheel holds through the next hard mile.", weight: 1, conditions: [Flag("wheel_repaired")], effects: [ClearFlag("wheel_repaired"), AdjustMorale(2)], choices: []),
        (id: "ox_lost_aftermath", text: "A bell answers from the willow bottoms. The missing ox has found the herd.", weight: 1, conditions: [Flag("ox_lost_resolved")], effects: [ClearFlag("ox_lost_resolved"), AdjustMorale(3)], choices: []),
        (id: "fruit_aftermath", text: "By morning, the party has sorted the good fruit from the bitter skins.", weight: 1, conditions: [Flag("fruit_resolved")], effects: [AdjustFood(8), ClearFlag("fruit_resolved")], choices: []),
        (id: "letter_aftermath", text: "The eastbound rider disappears over the rise with the letter safe in a leather pouch.", weight: 1, conditions: [Flag("letter_sent")], effects: [ClearFlag("letter_sent"), AdjustMorale(2)], choices: []),
        (id: "heat_aftermath", text: "Evening brings a thin breeze, and the camp takes water slowly beneath the canvas.", weight: 1, conditions: [Flag("heat_resolved")], effects: [ClearFlag("heat_resolved"), AdjustMorale(2)], choices: []),
    ],
    quotes: [
        (id: "talk_1", text: "Abigail Reed: I mend what I can before supper, for dark makes every task twice as dear.", landmark_id: Some("independence"), seasons: [Spring], state_tags: ["hungry"]),
        (id: "talk_2", text: "Elias Boone: A shared cup of coffee can settle a quarrel no sermon touches.", landmark_id: Some("fort_kearney"), seasons: [Summer], state_tags: ["sick"]),
        (id: "talk_3", text: "Martha Bell: I mark each good water place in my book for the families behind us.", landmark_id: Some("chimney_rock"), seasons: [Autumn], state_tags: ["late"]),
        (id: "talk_4", text: "Thomas Hale: The prairie looks empty until you need a place to shelter.", landmark_id: Some("fort_laramie"), seasons: [Winter], state_tags: ["wealthy"]),
        (id: "talk_5", text: "Ruth Mercer: We travel best when the children have a song for the last mile.", landmark_id: Some("independence_rock"), seasons: [Spring], state_tags: ["homesick"]),
        (id: "talk_6", text: "Silas Ward: At every fort, ask what has happened ahead, then ask who is telling it.", landmark_id: Some("south_pass"), seasons: [Summer], state_tags: ["weary"]),
        (id: "talk_7", text: "Hannah Cole: A trade is fair only if both parties can afford to remember it kindly.", landmark_id: Some("fort_bridger"), seasons: [Autumn], state_tags: ["hopeful"]),
        (id: "talk_8", text: "Josiah Price: At sunset I count the living blessings before I count the losses.", landmark_id: Some("fort_hall"), seasons: [Winter], state_tags: ["cold"]),
        (id: "talk_9", text: "Eliza Grant: The mountains are not cruel, but they do not make allowances.", landmark_id: Some("fort_boise"), seasons: [Spring], state_tags: ["thirsty"]),
