GameContent(
    eras: [
        (id: "1843", name: "First Great Emigration", year: 1843),
        (id: "1848", name: "Gold and Territory", year: 1848),
        (id: "1852", name: "Peak Emigration", year: 1852),
        (id: "1866", name: "After the War", year: 1866),
    ],
    occupations: [
        (id: "banker", name: "Banker", starting_cash_cents: 160000, score_multiplier: 1.0, perk: "Haggles for better fort prices."),
        (id: "merchant", name: "Merchant", starting_cash_cents: 140000, score_multiplier: 1.0, perk: "Begins with trade goods and knows their value."),
        (id: "doctor", name: "Doctor", starting_cash_cents: 120000, score_multiplier: 1.5, perk: "Treats illness with steadier hands."),
        (id: "blacksmith", name: "Blacksmith", starting_cash_cents: 90000, score_multiplier: 2.0, perk: "Can repair wagon parts without a spare."),
        (id: "carpenter", name: "Carpenter", starting_cash_cents: 80000, score_multiplier: 2.0, perk: "Repairs quickly and buys spares cheaply."),
        (id: "hunter", name: "Hunter / Trapper", starting_cash_cents: 60000, score_multiplier: 2.5, perk: "Carries more meat and wastes less on the hunt."),
        (id: "preacher", name: "Preacher", starting_cash_cents: 50000, score_multiplier: 2.5, perk: "Raises morale and earns goodwill."),
        (id: "farmer", name: "Farmer", starting_cash_cents: 40000, score_multiplier: 3.0, perk: "Keeps oxen healthy and finds forage."),
        (id: "soldier", name: "Soldier", starting_cash_cents: 70000, score_multiplier: 2.0, perk: "Discourages theft and buys ammunition cheaply."),
    ],
    items: [
        (id: "oxen", name: "Oxen", unit: "yoke", price_cents: 4000, weight_lbs: 0, limit: 9),
        (id: "food", name: "Food", unit: "lb", price_cents: 20, weight_lbs: 1, limit: 2000),
        (id: "clothing", name: "Clothing", unit: "set", price_cents: 1000, weight_lbs: 2, limit: 99),
        (id: "ammunition", name: "Ammunition", unit: "box of 20", price_cents: 200, weight_lbs: 1, limit: 99),
        (id: "wheel", name: "Wagon wheel", unit: "each", price_cents: 1000, weight_lbs: 30, limit: 3),
        (id: "axle", name: "Wagon axle", unit: "each", price_cents: 1000, weight_lbs: 40, limit: 3),
        (id: "tongue", name: "Wagon tongue", unit: "each", price_cents: 1000, weight_lbs: 25, limit: 3),
        (id: "medicine", name: "Medicine", unit: "kit", price_cents: 1500, weight_lbs: 2, limit: 5),
        (id: "tools", name: "Tools", unit: "set", price_cents: 2500, weight_lbs: 15, limit: 1),
        (id: "trade_goods", name: "Trade goods", unit: "lot", price_cents: 2000, weight_lbs: 10, limit: 10),
    ],
    ailments: [
        (id: "typhoid", name: "Typhoid", severity: 5, daily_damage: 4, mortality_per_mille: 110),
        (id: "cholera", name: "Cholera", severity: 5, daily_damage: 5, mortality_per_mille: 170),
        (id: "measles", name: "Measles", severity: 3, daily_damage: 2, mortality_per_mille: 25),
        (id: "dysentery", name: "Dysentery", severity: 4, daily_damage: 3, mortality_per_mille: 65),
        (id: "exhaustion", name: "Exhaustion", severity: 2, daily_damage: 2, mortality_per_mille: 10),
        (id: "fever", name: "Fever", severity: 3, daily_damage: 2, mortality_per_mille: 35),
        (id: "snakebite", name: "Snakebite", severity: 4, daily_damage: 3, mortality_per_mille: 45),
        (id: "broken_arm", name: "Broken arm", severity: 3, daily_damage: 1, mortality_per_mille: 8),
        (id: "broken_leg", name: "Broken leg", severity: 4, daily_damage: 2, mortality_per_mille: 28),
        (id: "mountain_fever", name: "Mountain fever", severity: 4, daily_damage: 3, mortality_per_mille: 70),
        (id: "scurvy", name: "Scurvy", severity: 3, daily_damage: 2, mortality_per_mille: 22),
        (id: "frostbite", name: "Frostbite", severity: 3, daily_damage: 2, mortality_per_mille: 20),
        (id: "heat_stroke", name: "Heat stroke", severity: 4, daily_damage: 3, mortality_per_mille: 50),
        (id: "pneumonia", name: "Pneumonia", severity: 5, daily_damage: 4, mortality_per_mille: 125),
        (id: "infection", name: "Infection", severity: 4, daily_damage: 3, mortality_per_mille: 75),
        (id: "food_poisoning", name: "Food poisoning", severity: 3, daily_damage: 2, mortality_per_mille: 30),
        (id: "childbirth_complications", name: "Childbirth complications", severity: 5, daily_damage: 5, mortality_per_mille: 160),
        (id: "depression", name: "Melancholy", severity: 3, daily_damage: 1, mortality_per_mille: 15),
        (id: "tooth_abscess", name: "Tooth abscess", severity: 2, daily_damage: 2, mortality_per_mille: 12),
        (id: "gunshot", name: "Gunshot wound", severity: 5, daily_damage: 4, mortality_per_mille: 100),
        (id: "sprain", name: "Sprain", severity: 2, daily_damage: 1, mortality_per_mille: 4),
        (id: "whooping_cough", name: "Whooping cough", severity: 3, daily_damage: 2, mortality_per_mille: 24),
    ],
    trails: [
        (id: "oregon", name: "Oregon Trail", start_node_id: "independence", goal_node_id: "willamette", nodes: [
            (id:"independence",name:"Independence, Missouri",mile:0,kind:Town,routes:[(id:"main",label:"Follow the Platte road",target_id:"kansas_river",distance_miles:102)],river:None,store:true),
            (id:"kansas_river",name:"Kansas River Crossing",mile:102,kind:River,routes:[(id:"main",label:"Continue west",target_id:"big_blue",distance_miles:83)],river:Some((width_feet:620,depth_feet:4,ferry_cost_cents:Some(500))),store:false),
            (id:"big_blue",name:"Big Blue River Crossing",mile:185,kind:River,routes:[(id:"main",label:"Take the Platte road",target_id:"fort_kearney",distance_miles:119)],river:Some((width_feet:180,depth_feet:3,ferry_cost_cents:None)),store:false),
            (id:"fort_kearney",name:"Fort Kearney",mile:304,kind:Fort,routes:[(id:"main",label:"Follow the Platte",target_id:"chimney_rock",distance_miles:250)],river:None,store:true),
            (id:"chimney_rock",name:"Chimney Rock",mile:554,kind:Landmark,routes:[(id:"main",label:"Travel to Fort Laramie",target_id:"fort_laramie",distance_miles:86)],river:None,store:false),
            (id:"fort_laramie",name:"Fort Laramie",mile:640,kind:Fort,routes:[(id:"main",label:"Climb toward Independence Rock",target_id:"independence_rock",distance_miles:190)],river:None,store:true),
            (id:"independence_rock",name:"Independence Rock",mile:830,kind:Landmark,routes:[(id:"main",label:"Cross to South Pass",target_id:"south_pass",distance_miles:102)],river:None,store:false),
            (id:"south_pass",name:"South Pass",mile:932,kind:Fork,routes:[(id:"green",label:"Green River shortcut",target_id:"green_river",distance_miles:57),(id:"bridger",label:"Fort Bridger road",target_id:"fort_bridger",distance_miles:219)],river:None,store:false),
            (id:"green_river",name:"Green River Crossing",mile:989,kind:River,routes:[(id:"shortcut",label:"Continue to Soda Springs",target_id:"soda_springs",distance_miles:154)],river:Some((width_feet:300,depth_feet:4,ferry_cost_cents:None)),store:false),
            (id:"fort_bridger",name:"Fort Bridger",mile:1151,kind:Fort,routes:[(id:"main",label:"Travel to Soda Springs",target_id:"soda_springs",distance_miles:144)],river:None,store:true),
            (id:"soda_springs",name:"Soda Springs",mile:1143,kind:Landmark,routes:[(id:"main",label:"Travel to Fort Hall",target_id:"fort_hall",distance_miles:57)],river:None,store:false),
            (id:"fort_hall",name:"Fort Hall",mile:1200,kind:Fort,routes:[(id:"main",label:"Follow Snake River",target_id:"snake_river",distance_miles:180)],river:None,store:true),
            (id:"snake_river",name:"Snake River Crossing",mile:1380,kind:River,routes:[(id:"main",label:"Travel to Fort Boise",target_id:"fort_boise",distance_miles:113)],river:Some((width_feet:500,depth_feet:5,ferry_cost_cents:None)),store:false),
            (id:"fort_boise",name:"Fort Boise",mile:1493,kind:Fort,routes:[(id:"main",label:"Climb toward Blue Mountains",target_id:"blue_mountains",distance_miles:160)],river:None,store:true),
            (id:"blue_mountains",name:"Blue Mountains",mile:1653,kind:Fork,routes:[(id:"dalles",label:"Road to The Dalles",target_id:"the_dalles",distance_miles:160),(id:"walla",label:"Stop at Fort Walla Walla",target_id:"fort_walla_walla",distance_miles:55)],river:None,store:false),
            (id:"fort_walla_walla",name:"Fort Walla Walla",mile:1708,kind:Fort,routes:[(id:"main",label:"Travel to The Dalles",target_id:"the_dalles",distance_miles:105)],river:None,store:true),
            (id:"the_dalles",name:"The Dalles",mile:1813,kind:Finale,routes:[(id:"barlow",label:"Take the Barlow toll road",target_id:"willamette",distance_miles:72),(id:"columbia",label:"Raft the Columbia",target_id:"willamette",distance_miles:72)],river:Some((width_feet:900,depth_feet:12,ferry_cost_cents:None)),store:false),
            (id:"willamette",name:"Willamette Valley",mile:1885,kind:Finale,routes:[],river:None,store:false),
        ]),
        (id:"california",name:"California Trail",start_node_id:"independence_ca",goal_node_id:"sutters_fort",nodes:[
            (id:"independence_ca",name:"Independence, Missouri",mile:0,kind:Town,routes:[(id:"main",label:"Join the Platte road",target_id:"fort_laramie_ca",distance_miles:640)],river:None,store:true),
            (id:"fort_laramie_ca",name:"Fort Laramie",mile:640,kind:Fort,routes:[(id:"main",label:"Cross South Pass",target_id:"fort_bridger_ca",distance_miles:511)],river:None,store:true),
            (id:"fort_bridger_ca",name:"Fort Bridger",mile:1151,kind:Fork,routes:[(id:"humboldt",label:"Take the Humboldt route",target_id:"humboldt",distance_miles:360),(id:"hastings",label:"Attempt the Hastings Cutoff",target_id:"salt_desert",distance_miles:430)],river:None,store:true),
            (id:"humboldt",name:"Humboldt River",mile:1511,kind:River,routes:[(id:"main",label:"Travel to the Sierra",target_id:"sierra",distance_miles:290)],river:Some((width_feet:100,depth_feet:2,ferry_cost_cents:None)),store:false),
            (id:"salt_desert",name:"Great Salt Desert",mile:1581,kind:Landmark,routes:[(id:"main",label:"Rejoin at Humboldt",target_id:"humboldt",distance_miles:80)],river:None,store:false),
            (id:"sierra",name:"Sierra Nevada",mile:1801,kind:Fork,routes:[(id:"carson",label:"Use Carson Pass",target_id:"sutters_fort",distance_miles:199),(id:"truckee",label:"Use Truckee route",target_id:"sutters_fort",distance_miles:199)],river:None,store:false),
            (id:"sutters_fort",name:"Sutter's Fort",mile:2000,kind:Finale,routes:[],river:None,store:true),
        ]),
        (id:"mormon",name:"Mormon Pioneer Trail",start_node_id:"nauvoo",goal_node_id:"salt_lake",nodes:[
            (id:"nauvoo",name:"Nauvoo, Illinois",mile:0,kind:Town,routes:[(id:"iowa",label:"Cross Iowa toward Council Bluffs",target_id:"council_bluffs",distance_miles:317)],river:None,store:true),
            (id:"council_bluffs",name:"Council Bluffs",mile:317,kind:Town,routes:[(id:"north_bank",label:"Follow the north bank",target_id:"winter_quarters",distance_miles:30)],river:None,store:true),
            (id:"winter_quarters",name:"Winter Quarters",mile:347,kind:Landmark,routes:[(id:"plains",label:"Travel the north Platte road",target_id:"fort_laramie_mo",distance_miles:481)],river:None,store:true),
            (id:"fort_laramie_mo",name:"Fort Laramie",mile:828,kind:Fort,routes:[(id:"main",label:"Cross toward South Pass",target_id:"south_pass_mo",distance_miles:220)],river:None,store:true),
            (id:"south_pass_mo",name:"South Pass",mile:1048,kind:Landmark,routes:[(id:"bridger",label:"Travel to Fort Bridger",target_id:"fort_bridger_mo",distance_miles:103)],river:None,store:false),
            (id:"fort_bridger_mo",name:"Fort Bridger",mile:1151,kind:Fork,routes:[(id:"hastings",label:"Take the improved wagon road",target_id:"echo_canyon",distance_miles:190)],river:None,store:true),
            (id:"echo_canyon",name:"Echo Canyon",mile:1341,kind:Landmark,routes:[(id:"main",label:"Descend to Salt Lake Valley",target_id:"salt_lake",distance_miles:74)],river:None,store:false),
            (id:"salt_lake",name:"Great Salt Lake Valley",mile:1415,kind:Finale,routes:[],river:None,store:true),
        ]),
    ],
    events: [
        (id: "wheel_1", text: "A wheel splinters where the ruts have hardened like fired clay.", weight: 4, conditions: [All([Trail("oregon"), Era("1843"), Season(Spring)])], effects: [AdjustMorale(-2), Schedule(event_id: "wheel_aftermath", days: 2)], choices: [(id: "act", label: "A spare wheel restores the wagon; a repair costs a day.", effects: [SetFlag("wheel_repaired"), SetFlag("wheel_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "axle_2", text: "The axle groans, then breaks beneath the wagon's load.", weight: 5, conditions: [Any([FoodBelow(183), Weather(Hot)])], effects: [LoseDays(1)], choices: [(id: "act", label: "A careful repair preserves the load but delays the party.", effects: [SetFlag("axle_repaired"), SetFlag("axle_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "tongue_3", text: "The wagon tongue cracks while the oxen pull uphill.", weight: 6, conditions: [MilesAtLeast(82)], effects: [LoseDays(1)], choices: [(id: "act", label: "Tools and patience can keep the team moving.", effects: [SetFlag("tongue_mended"), SetFlag("tongue_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "mud_4", text: "Rain turns the low ground to a brown suction around the wheels.", weight: 7, conditions: [Not(Flag("mud_resolved"))], effects: [LoseDays(1)], choices: [(id: "act", label: "Unloading the wagon saves it from sinking deeper.", effects: [AdjustFood(-12), SetFlag("mud_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "fire_5", text: "A coal escapes the cook fire and catches a corner of canvas.", weight: 8, conditions: [DayAtLeast(7)], effects: [AdjustFood(-18)], choices: [(id: "act", label: "Quick hands spare the wagon, though part of the food is ruined.", effects: [AdjustMorale(-3), SetFlag("fire_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "ox_lame_6", text: "One ox favors a foreleg after a rough stretch of stone.", weight: 9, conditions: [All([Trail("oregon"), Season(Summer)])], effects: [LoseDays(1)], choices: [(id: "act", label: "Rest may save the animal from a worse injury.", effects: [SetFlag("lame_ox"), SetFlag("ox_lame_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "ox_lost_7", text: "At dawn an ox is missing, its rope cut or slipped in the night.", weight: 10, conditions: [Any([FoodBelow(198), Weather(Storm)])], effects: [LoseDays(1), Schedule(event_id: "ox_lost_aftermath", days: 2)], choices: [(id: "act", label: "Tracks lead into tall grass before the morning wind erases them.", effects: [AdjustMorale(-2), SetFlag("ox_lost_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "stampede_8", text: "A frightened herd thunders across the trail and scatters the team.", weight: 4, conditions: [MilesAtLeast(137)], effects: [AdjustMorale(-4)], choices: [(id: "act", label: "The dust settles with the wagons still upright.", effects: [SetFlag("stampede"), SetFlag("stampede_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "snake_9", text: "A snake strikes from beneath a sage clump beside the camp.", weight: 5, conditions: [Not(Flag("snake_resolved"))], effects: [InflictAilment("snakebite")], choices: [(id: "act", label: "The bite swells before the kettle has boiled.", effects: [AdjustMorale(-3), SetFlag("snake_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "bear_10", text: "A bear noses through camp at the edge of dusk.", weight: 6, conditions: [DayAtLeast(12)], effects: [AdjustFood(-20)], choices: [(id: "act", label: "It leaves only after overturning a flour sack.", effects: [AdjustMorale(-2), SetFlag("bear_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "bad_water_11", text: "The water looks clear, but a bitter smell rises when it is boiled.", weight: 7, conditions: [All([Trail("oregon"), Season(Autumn)])], effects: [InflictAilment("dysentery")], choices: [(id: "act", label: "Several cups have already been drunk.", effects: [SetFlag("bad_water"), SetFlag("bad_water_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "dry_spring_12", text: "The marked spring is a basin of cracked mud.", weight: 8, conditions: [Any([FoodBelow(213), Weather(Cold)])], effects: [AdjustFood(-8)], choices: [(id: "act", label: "The party must ration until another watercourse is found.", effects: [AdjustMorale(-4), SetFlag("dry_spring_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "fruit_13", text: "Wild plums hang above a sheltered bend in the trail.", weight: 9, conditions: [MilesAtLeast(192)], effects: [AdjustFood(16), Schedule(event_id: "fruit_aftermath", days: 2)], choices: [(id: "act", label: "The ripe fruit is welcome, but not every branch is safe to taste.", effects: [AdjustMorale(2), SetFlag("fruit_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "fish_14", text: "A quiet pool holds fish beneath the reeds.", weight: 10, conditions: [Not(Flag("fish_resolved"))], effects: [AdjustFood(24)], choices: [(id: "act", label: "A line and an hour at the bank bring supper within reach.", effects: [AdjustMorale(2), SetFlag("fish_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "game_15", text: "Fresh tracks cross the trail at first light.", weight: 4, conditions: [DayAtLeast(17)], effects: [SetFlag("fresh_game")], choices: [(id: "act", label: "A hunter can follow them while the wagon train waits.", effects: [AdjustMorale(1), SetFlag("game_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "thief_16", text: "A small bundle is missing from beside the wagon at dawn.", weight: 5, conditions: [All([Trail("oregon"), Season(Winter)])], effects: [AdjustCash(-300)], choices: [(id: "act", label: "No one saw a face in the night.", effects: [AdjustMorale(-4), SetFlag("thief_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "stranger_17", text: "A lone traveler walks beside the road with a broken harness.", weight: 6, conditions: [Any([FoodBelow(228), Weather(Rain)])], effects: [SetFlag("stranger_met")], choices: [(id: "act", label: "They offer news and a steady hand in exchange for a place near the fire.", effects: [AdjustMorale(2), SetFlag("stranger_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "argument_18", text: "Two members argue over the last dry blankets.", weight: 7, conditions: [MilesAtLeast(247)], effects: [AdjustMorale(-6)], choices: [(id: "act", label: "The quarrel quiets only when the fire burns low.", effects: [SetFlag("argument"), SetFlag("argument_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "letter_19", text: "A rider carries a bundle of letters east and agrees to take one.", weight: 8, conditions: [Not(Flag("letter_resolved"))], effects: [AdjustMorale(3), Schedule(event_id: "letter_aftermath", days: 2)], choices: [(id: "act", label: "The camp grows still as each person considers home.", effects: [SetFlag("letter_sent"), SetFlag("letter_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "grave_20", text: "A cedar marker stands beside the road, its lettering nearly worn away.", weight: 9, conditions: [DayAtLeast(22)], effects: [AdjustMorale(-2)], choices: [(id: "act", label: "The party speaks softly and travels on with care.", effects: [SetFlag("saw_grave"), SetFlag("grave_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "lost_trail_21", text: "Wind has erased the wheel ruts at a fork in the grass.", weight: 10, conditions: [All([Trail("oregon"), Season(Spring)])], effects: [LoseDays(2)], choices: [(id: "act", label: "The compass gives a direction, but not a road.", effects: [AdjustMorale(-3), SetFlag("lost_trail_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "rough_trail_22", text: "Sharp stone and washouts make each mile a labor.", weight: 4, conditions: [Any([FoodBelow(243), Weather(Hot)])], effects: [LoseDays(1)], choices: [(id: "act", label: "The wagon must be guided by hand through the worst places.", effects: [AdjustMorale(-2), SetFlag("rough_trail_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "grass_23", text: "The grazing is cropped close and dry around the camp.", weight: 5, conditions: [MilesAtLeast(302)], effects: [LoseDays(1)], choices: [(id: "act", label: "The oxen need a longer halt or a poorer supper.", effects: [AdjustFood(-6), SetFlag("grass_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "hail_24", text: "Hail rattles on the wagon cover and bruises the grazing oxen.", weight: 6, conditions: [Not(Flag("hail_resolved"))], effects: [AdjustMorale(-2)], choices: [(id: "act", label: "The storm passes quickly, leaving a cold silence.", effects: [SetFlag("hail"), SetFlag("hail_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "heat_25", text: "The air shimmers above the road before noon.", weight: 7, conditions: [DayAtLeast(27)], effects: [InflictAilment("heat_stroke"), Schedule(event_id: "heat_aftermath", days: 2)], choices: [(id: "act", label: "Work slows as canteens grow light.", effects: [AdjustMorale(-3), SetFlag("heat_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "cold_26", text: "A hard freeze comes before the party has settled camp.", weight: 8, conditions: [All([Trail("oregon"), Season(Summer)])], effects: [InflictAilment("frostbite")], choices: [(id: "act", label: "Wet cloth stiffens on the wagon rails.", effects: [AdjustMorale(-4), SetFlag("cold_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "fog_27", text: "Morning fog hides the next bend and muffles every sound.", weight: 9, conditions: [Any([FoodBelow(258), Weather(Storm)])], effects: [LoseDays(1)], choices: [(id: "act", label: "The train advances only when the lead team can be seen.", effects: [SetFlag("fog"), SetFlag("fog_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "flood_28", text: "A distant storm sends muddy water across the low trail.", weight: 10, conditions: [MilesAtLeast(357)], effects: [LoseDays(2)], choices: [(id: "act", label: "The wagons wait above the wash until it falls.", effects: [AdjustMorale(-3), SetFlag("flood_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "help_train_29", text: "An emigrant wagon is tipped in a ditch, its family stranded beside it.", weight: 4, conditions: [Not(Flag("help_train_resolved"))], effects: [SetFlag("helped_train")], choices: [(id: "act", label: "Their driver asks for hands before night reaches the valley.", effects: [AdjustMorale(3), SetFlag("help_train_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
        (id: "trader_30", text: "A trader greets the camp with goods packed in careful bundles.", weight: 5, conditions: [DayAtLeast(32)], effects: [SetFlag("trader_seen")], choices: [(id: "act", label: "A fair exchange could lighten one need and worsen another.", effects: [AdjustMorale(1), SetFlag("trader_resolved")]), (id: "continue", label: "Continue on the trail.", effects: [AdjustMorale(-1)])]),
