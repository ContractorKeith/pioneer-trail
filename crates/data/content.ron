GameContent(
    eras: [
        (id: "1843", name: "First Great Emigration", year: 1843),
        (id: "1848", name: "Gold and Territory", year: 1848),
        (id: "1852", name: "Peak Emigration", year: 1852),
        (id: "1866", name: "After the War", year: 1866),
    ],
    occupations: [
        (id: "banker", name: "Banker", starting_cash_cents: 160000, score_multiplier: 1.0, perk: "Haggles for better fort prices."),
        (id: "merchant", name: "Merchant", starting_cash_cents: 140000, score_multiplier: 1.0, perk: "Begins with trade goods and knows their value."),
        (id: "doctor", name: "Doctor", starting_cash_cents: 120000, score_multiplier: 1.5, perk: "Treats illness with steadier hands."),
        (id: "blacksmith", name: "Blacksmith", starting_cash_cents: 90000, score_multiplier: 2.0, perk: "Can repair wagon parts without a spare."),
        (id: "carpenter", name: "Carpenter", starting_cash_cents: 80000, score_multiplier: 2.0, perk: "Repairs quickly and buys spares cheaply."),
        (id: "hunter", name: "Hunter / Trapper", starting_cash_cents: 60000, score_multiplier: 2.5, perk: "Carries more meat and wastes less on the hunt."),
        (id: "preacher", name: "Preacher", starting_cash_cents: 50000, score_multiplier: 2.5, perk: "Raises morale and earns goodwill."),
        (id: "farmer", name: "Farmer", starting_cash_cents: 40000, score_multiplier: 3.0, perk: "Keeps oxen healthy and finds forage."),
        (id: "soldier", name: "Soldier", starting_cash_cents: 70000, score_multiplier: 2.0, perk: "Discourages theft and buys ammunition cheaply."),
    ],
    items: [
        (id: "oxen", name: "Oxen", unit: "yoke", price_cents: 4000, weight_lbs: 0, limit: 9),
        (id: "food", name: "Food", unit: "lb", price_cents: 20, weight_lbs: 1, limit: 2000),
        (id: "clothing", name: "Clothing", unit: "set", price_cents: 1000, weight_lbs: 2, limit: 99),
        (id: "ammunition", name: "Ammunition", unit: "box of 20", price_cents: 200, weight_lbs: 1, limit: 99),
        (id: "wheel", name: "Wagon wheel", unit: "each", price_cents: 1000, weight_lbs: 30, limit: 3),
        (id: "axle", name: "Wagon axle", unit: "each", price_cents: 1000, weight_lbs: 40, limit: 3),
        (id: "tongue", name: "Wagon tongue", unit: "each", price_cents: 1000, weight_lbs: 25, limit: 3),
        (id: "medicine", name: "Medicine", unit: "kit", price_cents: 1500, weight_lbs: 2, limit: 5),
        (id: "tools", name: "Tools", unit: "set", price_cents: 2500, weight_lbs: 15, limit: 1),
        (id: "trade_goods", name: "Trade goods", unit: "lot", price_cents: 2000, weight_lbs: 10, limit: 10),
    ],
    ailments: [
        (id: "typhoid", name: "Typhoid", severity: 5, daily_damage: 4, mortality_per_mille: 110),
        (id: "cholera", name: "Cholera", severity: 5, daily_damage: 5, mortality_per_mille: 170),
        (id: "measles", name: "Measles", severity: 3, daily_damage: 2, mortality_per_mille: 25),
        (id: "dysentery", name: "Dysentery", severity: 4, daily_damage: 3, mortality_per_mille: 65),
        (id: "exhaustion", name: "Exhaustion", severity: 2, daily_damage: 2, mortality_per_mille: 10),
        (id: "fever", name: "Fever", severity: 3, daily_damage: 2, mortality_per_mille: 35),
        (id: "snakebite", name: "Snakebite", severity: 4, daily_damage: 3, mortality_per_mille: 45),
        (id: "broken_arm", name: "Broken arm", severity: 3, daily_damage: 1, mortality_per_mille: 8),
        (id: "broken_leg", name: "Broken leg", severity: 4, daily_damage: 2, mortality_per_mille: 28),
        (id: "mountain_fever", name: "Mountain fever", severity: 4, daily_damage: 3, mortality_per_mille: 70),
        (id: "scurvy", name: "Scurvy", severity: 3, daily_damage: 2, mortality_per_mille: 22),
        (id: "frostbite", name: "Frostbite", severity: 3, daily_damage: 2, mortality_per_mille: 20),
        (id: "heat_stroke", name: "Heat stroke", severity: 4, daily_damage: 3, mortality_per_mille: 50),
        (id: "pneumonia", name: "Pneumonia", severity: 5, daily_damage: 4, mortality_per_mille: 125),
        (id: "infection", name: "Infection", severity: 4, daily_damage: 3, mortality_per_mille: 75),
        (id: "food_poisoning", name: "Food poisoning", severity: 3, daily_damage: 2, mortality_per_mille: 30),
        (id: "childbirth_complications", name: "Childbirth complications", severity: 5, daily_damage: 5, mortality_per_mille: 160),
        (id: "depression", name: "Melancholy", severity: 3, daily_damage: 1, mortality_per_mille: 15),
        (id: "tooth_abscess", name: "Tooth abscess", severity: 2, daily_damage: 2, mortality_per_mille: 12),
        (id: "gunshot", name: "Gunshot wound", severity: 5, daily_damage: 4, mortality_per_mille: 100),
        (id: "sprain", name: "Sprain", severity: 2, daily_damage: 1, mortality_per_mille: 4),
        (id: "whooping_cough", name: "Whooping cough", severity: 3, daily_damage: 2, mortality_per_mille: 24),
    ],
    trails: [
        (id: "oregon", name: "Oregon Trail", start_node_id: "independence", goal_node_id: "willamette", nodes: [
            (id:"independence",name:"Independence, Missouri",mile:0,kind:Town,routes:[(id:"main",label:"Follow the Platte road",target_id:"kansas_river",distance_miles:102)],river:None,store:true),
            (id:"kansas_river",name:"Kansas River Crossing",mile:102,kind:River,routes:[(id:"main",label:"Continue west",target_id:"big_blue",distance_miles:83)],river:Some((width_feet:620,depth_feet:4,ferry_cost_cents:Some(500))),store:false),
            (id:"big_blue",name:"Big Blue River Crossing",mile:185,kind:River,routes:[(id:"main",label:"Take the Platte road",target_id:"fort_kearney",distance_miles:119)],river:Some((width_feet:180,depth_feet:3,ferry_cost_cents:None)),store:false),
            (id:"fort_kearney",name:"Fort Kearney",mile:304,kind:Fort,routes:[(id:"main",label:"Follow the Platte",target_id:"chimney_rock",distance_miles:250)],river:None,store:true),
            (id:"chimney_rock",name:"Chimney Rock",mile:554,kind:Landmark,routes:[(id:"main",label:"Travel to Fort Laramie",target_id:"fort_laramie",distance_miles:86)],river:None,store:false),
            (id:"fort_laramie",name:"Fort Laramie",mile:640,kind:Fort,routes:[(id:"main",label:"Climb toward Independence Rock",target_id:"independence_rock",distance_miles:190)],river:None,store:true),
            (id:"independence_rock",name:"Independence Rock",mile:830,kind:Landmark,routes:[(id:"main",label:"Cross to South Pass",target_id:"south_pass",distance_miles:102)],river:None,store:false),
            (id:"south_pass",name:"South Pass",mile:932,kind:Fork,routes:[(id:"green",label:"Green River shortcut",target_id:"green_river",distance_miles:57),(id:"bridger",label:"Fort Bridger road",target_id:"fort_bridger",distance_miles:219)],river:None,store:false),
            (id:"green_river",name:"Green River Crossing",mile:989,kind:River,routes:[(id:"shortcut",label:"Continue to Soda Springs",target_id:"soda_springs",distance_miles:154)],river:Some((width_feet:300,depth_feet:4,ferry_cost_cents:None)),store:false),
            (id:"fort_bridger",name:"Fort Bridger",mile:1151,kind:Fort,routes:[(id:"main",label:"Travel to Soda Springs",target_id:"soda_springs",distance_miles:144)],river:None,store:true),
            (id:"soda_springs",name:"Soda Springs",mile:1143,kind:Landmark,routes:[(id:"main",label:"Travel to Fort Hall",target_id:"fort_hall",distance_miles:57)],river:None,store:false),
            (id:"fort_hall",name:"Fort Hall",mile:1200,kind:Fort,routes:[(id:"main",label:"Follow Snake River",target_id:"snake_river",distance_miles:180)],river:None,store:true),
            (id:"snake_river",name:"Snake River Crossing",mile:1380,kind:River,routes:[(id:"main",label:"Travel to Fort Boise",target_id:"fort_boise",distance_miles:113)],river:Some((width_feet:500,depth_feet:5,ferry_cost_cents:None)),store:false),
            (id:"fort_boise",name:"Fort Boise",mile:1493,kind:Fort,routes:[(id:"main",label:"Climb toward Blue Mountains",target_id:"blue_mountains",distance_miles:160)],river:None,store:true),
            (id:"blue_mountains",name:"Blue Mountains",mile:1653,kind:Fork,routes:[(id:"dalles",label:"Road to The Dalles",target_id:"the_dalles",distance_miles:160),(id:"walla",label:"Stop at Fort Walla Walla",target_id:"fort_walla_walla",distance_miles:55)],river:None,store:false),
            (id:"fort_walla_walla",name:"Fort Walla Walla",mile:1708,kind:Fort,routes:[(id:"main",label:"Travel to The Dalles",target_id:"the_dalles",distance_miles:105)],river:None,store:true),
            (id:"the_dalles",name:"The Dalles",mile:1813,kind:Finale,routes:[(id:"barlow",label:"Take the Barlow toll road",target_id:"willamette",distance_miles:72),(id:"columbia",label:"Raft the Columbia",target_id:"willamette",distance_miles:72)],river:Some((width_feet:900,depth_feet:12,ferry_cost_cents:None)),store:false),
            (id:"willamette",name:"Willamette Valley",mile:1885,kind:Finale,routes:[],river:None,store:false),
        ]),
        (id:"california",name:"California Trail",start_node_id:"independence_ca",goal_node_id:"sutters_fort",nodes:[
            (id:"independence_ca",name:"Independence, Missouri",mile:0,kind:Town,routes:[(id:"main",label:"Join the Platte road",target_id:"fort_laramie_ca",distance_miles:640)],river:None,store:true),
            (id:"fort_laramie_ca",name:"Fort Laramie",mile:640,kind:Fort,routes:[(id:"main",label:"Cross South Pass",target_id:"fort_bridger_ca",distance_miles:511)],river:None,store:true),
            (id:"fort_bridger_ca",name:"Fort Bridger",mile:1151,kind:Fork,routes:[(id:"humboldt",label:"Take the Humboldt route",target_id:"humboldt",distance_miles:360),(id:"hastings",label:"Attempt the Hastings Cutoff",target_id:"salt_desert",distance_miles:430)],river:None,store:true),
            (id:"humboldt",name:"Humboldt River",mile:1511,kind:River,routes:[(id:"main",label:"Travel to the Sierra",target_id:"sierra",distance_miles:290)],river:Some((width_feet:100,depth_feet:2,ferry_cost_cents:None)),store:false),
            (id:"salt_desert",name:"Great Salt Desert",mile:1581,kind:Landmark,routes:[(id:"main",label:"Rejoin at Humboldt",target_id:"humboldt",distance_miles:80)],river:None,store:false),
            (id:"sierra",name:"Sierra Nevada",mile:1801,kind:Fork,routes:[(id:"carson",label:"Use Carson Pass",target_id:"sutters_fort",distance_miles:199),(id:"truckee",label:"Use Truckee route",target_id:"sutters_fort",distance_miles:199)],river:None,store:false),
            (id:"sutters_fort",name:"Sutter's Fort",mile:2000,kind:Finale,routes:[],river:None,store:true),
        ]),
        (id:"mormon",name:"Mormon Pioneer Trail",start_node_id:"nauvoo",goal_node_id:"salt_lake",nodes:[
            (id:"nauvoo",name:"Nauvoo, Illinois",mile:0,kind:Town,routes:[(id:"iowa",label:"Cross Iowa toward Council Bluffs",target_id:"council_bluffs",distance_miles:317)],river:None,store:true),
            (id:"council_bluffs",name:"Council Bluffs",mile:317,kind:Town,routes:[(id:"north_bank",label:"Follow the north bank",target_id:"winter_quarters",distance_miles:30)],river:None,store:true),
            (id:"winter_quarters",name:"Winter Quarters",mile:347,kind:Landmark,routes:[(id:"plains",label:"Travel the north Platte road",target_id:"fort_laramie_mo",distance_miles:481)],river:None,store:true),
            (id:"fort_laramie_mo",name:"Fort Laramie",mile:828,kind:Fort,routes:[(id:"main",label:"Cross toward South Pass",target_id:"south_pass_mo",distance_miles:220)],river:None,store:true),
            (id:"south_pass_mo",name:"South Pass",mile:1048,kind:Landmark,routes:[(id:"bridger",label:"Travel to Fort Bridger",target_id:"fort_bridger_mo",distance_miles:103)],river:None,store:false),
            (id:"fort_bridger_mo",name:"Fort Bridger",mile:1151,kind:Fort,routes:[(id:"hastings",label:"Take the improved wagon road",target_id:"echo_canyon",distance_miles:190)],river:None,store:true),
            (id:"echo_canyon",name:"Echo Canyon",mile:1341,kind:Landmark,routes:[(id:"main",label:"Descend to Salt Lake Valley",target_id:"salt_lake",distance_miles:74)],river:None,store:false),
            (id:"salt_lake",name:"Great Salt Lake Valley",mile:1415,kind:Finale,routes:[],river:None,store:true),
        ]),
    ],
    events: [
        (id:"wheel",text:"A wheel splits on a hidden stone.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Fit the spare wheel",conditions:[InventoryAtLeast(item_id:"wheel",quantity:1)],effects:[AdjustItem(item_id:"wheel",quantity:-1),AdjustMorale(2)]),(id:"decline",label:"Leave the wagon to limp",effects:[LoseDays(2)])]),
        (id:"ferry",text:"The ferryman says the current will rise by nightfall.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Pay for the crossing",effects:[AdjustCash(-500)]),(id:"decline",label:"Wait for calmer water",effects:[LoseDays(2)])]),
        (id:"plum",text:"A thicket of wild plums grows beside the road.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Gather only ripe fruit",effects:[AdjustFood(18)]),(id:"decline",label:"Pass the thicket",effects:[AdjustMorale(-1)])]),
        (id:"ox",text:"An ox has tangled its hoof in a hobble chain.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Stop and tend the hoof",effects:[LoseDays(1)]),(id:"decline",label:"Press on before rain",effects:[AdjustMorale(-4)])]),
        (id:"water",text:"The spring tastes of iron and lies beneath a dead animal.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Boil and ration the water",effects:[LoseDays(1)]),(id:"decline",label:"Drink without waiting",effects:[InflictAilment("dysentery")])]),
        (id:"squall",text:"A black squall rolls across the prairie.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Circle the wagons",effects:[AdjustMorale(-1)]),(id:"decline",label:"Keep driving through it",effects:[AdjustFood(-14)])]),
        (id:"tracks",text:"Fresh deer tracks lead toward a cottonwood draw.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Send a hunter after them",effects:[SetFlag("fresh_game")]),(id:"decline",label:"Keep the party together",effects:[AdjustMorale(1)])]),
        (id:"stranded",text:"A family's wagon is sunk to its hubs in mud.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Give them an afternoon",effects:[AdjustMorale(4)]),(id:"decline",label:"Trade a rope for supplies",effects:[AdjustFood(10)])]),
        (id:"quarrel",text:"Two party members quarrel over the last dry blanket.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Hear them both by the fire",effects:[AdjustMorale(3)]),(id:"decline",label:"Order silence and sleep",effects:[AdjustMorale(-5)])]),
        (id:"medicine",text:"A traveling doctor offers a small tin of powders.",weight:5,conditions:[CashAtLeast(1500)],effects:[],choices:[(id:"act",label:"Buy the medicine",conditions:[CashAtLeast(1500)],effects:[AdjustCash(-1500),AdjustItem(item_id:"medicine",quantity:1)]),(id:"decline",label:"Keep the cash",effects:[AdjustMorale(-1)])]),
        (id:"smoke",text:"Smoke rises from grass ahead of the train.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Detour around the burn",effects:[LoseDays(1)]),(id:"decline",label:"Drive through before dusk",effects:[AdjustFood(-20)])]),
        (id:"ford",text:"The guide marks a shallow ford with willow stakes.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Hire the guide",effects:[AdjustCash(-300)]),(id:"decline",label:"Test the ford alone",effects:[AdjustMorale(-3)])]),
        (id:"letter",text:"An eastbound rider agrees to carry one letter.",weight:5,conditions:[AtLandmark("fort_kearney")],effects:[],choices:[(id:"act",label:"Write home before supper",effects:[SetFlag("letter_sent"),Schedule(event_id:"letter_reply",days:8)]),(id:"decline",label:"Let the rider pass",effects:[AdjustMorale(-1)])]),
        (id:"letter_reply",text:"Weeks later, another rider reports your letter reached the Missouri road.",weight:0,conditions:[Flag("letter_sent")],effects:[ClearFlag("letter_sent"),AdjustMorale(3)],choices:[]),
        (id:"fever",text:"A child in a nearby camp coughs through the night.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Move camp farther off",effects:[AdjustMorale(-1)]),(id:"decline",label:"Share your fire",effects:[InflictAilment("fever")])]),
        (id:"harness",text:"A leather harness snaps under the load.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Cut a replacement from spare leather",effects:[LoseDays(1)]),(id:"decline",label:"Patch it at the next fort",effects:[AdjustMorale(-2)])]),
        (id:"trader",text:"A Shoshone trader offers dried meat for cloth.",weight:5,conditions:[Trail("oregon")],effects:[],choices:[(id:"act",label:"Trade one clothing set",conditions:[InventoryAtLeast(item_id:"clothing",quantity:1)],effects:[AdjustItem(item_id:"clothing",quantity:-1),AdjustFood(28)]),(id:"decline",label:"Thank them and decline",effects:[AdjustMorale(1)])]),
        (id:"hail",text:"Hail tears through the canvas at midday.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Cover the food sacks",effects:[AdjustFood(-8)]),(id:"decline",label:"Save the canvas first",effects:[AdjustMorale(-3)])]),
        (id:"grave",text:"A weathered grave marker leans beside the ruts.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Stop for a quiet moment",effects:[AdjustMorale(2)]),(id:"decline",label:"Move on at once",effects:[AdjustMorale(-2)])]),
        (id:"bridge",text:"A timber bridge has lost two planks.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Rebuild the crossing",effects:[LoseDays(1)]),(id:"decline",label:"Unload and ford below",effects:[AdjustFood(-10)])]),
        (id:"rumor",text:"A rider brings news of gold west of the Sierra.",weight:5,conditions:[All([Trail("california"), Era("1848")])],effects:[],choices:[(id:"act",label:"Stay on the planned route",effects:[AdjustMorale(2)]),(id:"decline",label:"Chase the rumor",effects:[LoseDays(3)])]),
        (id:"frost",text:"A hard frost finds wet clothes on the wagon rails.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Make a long warming fire",effects:[AdjustFood(-6)]),(id:"decline",label:"Travel before the sun rises",effects:[InflictAilment("frostbite")])]),
        (id:"avalanche",text:"Loose stone rattles down the mountain cut.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Wait for the slope to settle",effects:[LoseDays(1)]),(id:"decline",label:"Rush the wagons through",effects:[AdjustMorale(-5)])]),
        (id:"birth",text:"A neighboring party asks for help with a difficult birth.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Send the doctor or midwife",effects:[AdjustMorale(5)]),(id:"decline",label:"Leave them supplies and go",effects:[AdjustFood(-12)])]),
        (id:"rations",text:"The flour barrel shows signs of weevils.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Sift and cook it now",effects:[AdjustFood(-6)]),(id:"decline",label:"Throw it out",effects:[AdjustFood(-35)])]),
        (id:"arrival",text:"An old emigrant points out a sheltered camp beyond the ridge.",weight:5,conditions:[Always],effects:[],choices:[(id:"act",label:"Follow the marked path",effects:[AdjustMorale(3)]),(id:"decline",label:"Choose your own camp",effects:[AdjustMorale(-2)])]),
    ],
    quotes: [
        (id:"talk_1",text:"Mara Vail: Keep the kettle clean; sickness starts in small neglect.",landmark_id:Some("independence"),seasons:[Spring],state_tags:["hungry"]),
        (id:"talk_2",text:"Ephraim Cole: I count rivers by their sound, not their color.",landmark_id:Some("kansas_river"),seasons:[Summer],state_tags:["sick"]),
        (id:"talk_3",text:"Nell Grant: A child sleeps better when someone tells the truth about tomorrow.",landmark_id:Some("big_blue"),seasons:[Autumn],state_tags:["late"]),
        (id:"talk_4",text:"Orson Pike: Never praise a shortcut until your wheels reach the other end.",landmark_id:Some("fort_kearney"),seasons:[Winter],state_tags:["wealthy"]),
        (id:"talk_5",text:"Clara Wynn: I save one dry match for the morning after rain.",landmark_id:Some("chimney_rock"),seasons:[Spring],state_tags:["homesick"]),
        (id:"talk_6",text:"Jon Bell: The oxen forgive hard miles less quickly than people do.",landmark_id:Some("fort_laramie"),seasons:[Summer],state_tags:["weary"]),
        (id:"talk_7",text:"Eliza Moss: A fair trade leaves both hands open.",landmark_id:Some("independence_rock"),seasons:[Autumn],state_tags:["hopeful"]),
        (id:"talk_8",text:"Abel Finch: South Pass feels gentle only to those who have not climbed it.",landmark_id:Some("south_pass"),seasons:[Winter],state_tags:["cold"]),
        (id:"talk_9",text:"Ruth Hale: We sing after supper so the homesick have company.",landmark_id:Some("green_river"),seasons:[Spring],state_tags:["thirsty"]),
        (id:"talk_10",text:"Micah Reed: A repaired strap deserves a second inspection.",landmark_id:Some("fort_bridger"),seasons:[Summer],state_tags:["grieving"]),
        (id:"talk_11",text:"Sarah Vance: I write down good water for the wagons behind us.",landmark_id:Some("soda_springs"),seasons:[Autumn],state_tags:["hungry"]),
        (id:"talk_12",text:"Caleb Ward: Weather is a neighbor that never asks permission.",landmark_id:Some("fort_hall"),seasons:[Winter],state_tags:["sick"]),
        (id:"talk_13",text:"Lydia Cross: Give grief a chair by the fire, then rise in the morning.",landmark_id:Some("snake_river"),seasons:[Spring],state_tags:["late"]),
        (id:"talk_14",text:"Thomas Quinn: The wagon tells you its trouble before it breaks.",landmark_id:Some("fort_boise"),seasons:[Summer],state_tags:["wealthy"]),
        (id:"talk_15",text:"Naomi Price: A full cup shared at dusk buys more peace than coin.",landmark_id:Some("blue_mountains"),seasons:[Autumn],state_tags:["homesick"]),
        (id:"talk_16",text:"Gideon Marsh: The mountains keep no account of anyone's hurry.",landmark_id:Some("the_dalles"),seasons:[Winter],state_tags:["weary"]),
        (id:"talk_17",text:"Mercy Stone: A small kindness can carry a party through a bad day.",landmark_id:Some("willamette"),seasons:[Spring],state_tags:["hopeful"]),
        (id:"talk_18",text:"Isaac Turner: I trust a calm river less than a noisy one.",landmark_id:Some("fort_laramie_ca"),seasons:[Summer],state_tags:["cold"]),
        (id:"talk_19",text:"Hannah Fox: The prairie is wide enough to teach patience.",landmark_id:Some("fort_bridger_ca"),seasons:[Autumn],state_tags:["thirsty"]),
        (id:"talk_20",text:"Josiah Wells: Let the weakest walker choose when camp is made.",landmark_id:Some("humboldt"),seasons:[Winter],state_tags:["grieving"]),
        (id:"talk_21",text:"Rebecca Hart: A fort's news is worth hearing twice from different mouths.",landmark_id:Some("sierra"),seasons:[Spring],state_tags:["hungry"]),
        (id:"talk_22",text:"Daniel Shaw: We travel lighter after we forgive one another.",landmark_id:Some("nauvoo"),seasons:[Summer],state_tags:["sick"]),
        (id:"talk_23",text:"Ada Boone: Good boots are quiet wealth on this road.",landmark_id:Some("winter_quarters"),seasons:[Autumn],state_tags:["late"]),
        (id:"talk_24",text:"Peter Lane: A clean bandage is better than a brave promise.",landmark_id:Some("echo_canyon"),seasons:[Winter],state_tags:["wealthy"]),
        (id:"talk_25",text:"Abigail Frost: The last mile is easier when someone is waiting at camp.",landmark_id:Some("salt_lake"),seasons:[Spring],state_tags:["homesick"]),
    ],
)
