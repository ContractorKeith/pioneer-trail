    (id:"thin_ice",text:"Ice has formed at the edge of a stream you must cross.",weight:3,conditions:[All([Season(Winter),Weather(Cold)])],effects:[],choices:[(id:"break",label:"Break the ice",effects:[LoseDays(1)]),(id:"search",label:"Search upstream",effects:[LoseDays(1),AdjustMorale(-1)])]),
    (id:"fort_surgeon",text:"A fort surgeon offers to examine the fevered member of your party.",weight:2,conditions:[All([AtLandmark("fort_hall"),HasAilment("fever")])],effects:[],choices:[(id:"pay",label:"Pay the surgeon",conditions:[CashAtLeast(1200)],effects:[AdjustCash(-1200),HealAilment("fever")]),(id:"wait",label:"Wait and watch",effects:[AdjustMorale(-1)])]),
    (id:"borrowed_ox",text:"A neighbor offers an extra ox for one difficult hill.",weight:2,conditions:[All([MilesAtLeast(600),MoraleBelow(50)])],effects:[],choices:[(id:"accept",label:"Accept the help",effects:[AdjustMorale(4),SetFlag("borrowed_ox"),Schedule(event_id:"ox_return",days:2)]),(id:"decline",label:"Decline with thanks",effects:[AdjustMorale(1)])]),
    (id:"ox_return",text:"You return the borrowed ox with a handful of oats at the next camp.",weight:0,conditions:[Flag("borrowed_ox")],effects:[ClearFlag("borrowed_ox"),AdjustFood(-4),AdjustMorale(2)],choices:[]),
    (id:"windfallen_tree",text:"A windfallen pine blocks the road through the timber.",weight:3,conditions:[All([Trail("oregon"),MilesAtLeast(1550),Weather(Storm)])],effects:[],choices:[(id:"cut",label:"Cut a passage",conditions:[InventoryAtLeast(item_id:"tools",quantity:1)],effects:[LoseDays(1)]),(id:"detour",label:"Take the ravine",effects:[LoseDays(1),AdjustMorale(-2)])]),
    (id:"cold_bedroll",text:"A bedroll has soaked through where rain found a gap in the cover.",weight:2,conditions:[Weather(Rain)],effects:[],choices:[(id:"dry",label:"Dry it by fire",effects:[LoseDays(1)]),(id:"share",label:"Share blankets",effects:[AdjustMorale(2)])]),
    (id:"river_cairn",text:"A line of river stones marks a safer place to water the animals.",weight:2,conditions:[All([Trail("oregon"),MilesAtLeast(1000)])],effects:[],choices:[(id:"follow",label:"Use the cairn",effects:[AdjustMorale(2)]),(id:"ignore",label:"Use the usual bank",effects:[AdjustFood(-5)])]),
    (id:"frayed_rein",text:"A rein is frayed almost through near the bit.",weight:2,conditions:[Always],effects:[],choices:[(id:"replace",label:"Replace the rein",conditions:[InventoryAtLeast(item_id:"clothing",quantity:1)],effects:[AdjustItem(item_id:"clothing",quantity:-1)]),(id:"knot",label:"Tie a knot",effects:[AdjustMorale(-1)])]),
    (id:"burned_bacon",text:"The bacon burns while everyone argues over tomorrow's road.",weight:1,conditions:[MoraleBelow(55)],effects:[],choices:[(id:"laugh",label:"Laugh it off",effects:[AdjustMorale(3),AdjustFood(-2)]),(id:"scold",label:"Scold the cook",effects:[AdjustMorale(-3)])]),
    (id:"prairie_well",text:"A hand-dug well stands beside a lonely abandoned cabin.",weight:2,conditions:[All([MilesAtLeast(150),Season(Summer)])],effects:[],choices:[(id:"draw",label:"Draw water",effects:[AdjustMorale(2)]),(id:"boil",label:"Boil water first",effects:[LoseDays(1)])]),
    (id:"broken_compass",text:"The compass needle sticks against its cracked glass.",weight:2,conditions:[Weather(Rain)],effects:[],choices:[(id:"repair",label:"Tap it free",conditions:[InventoryAtLeast(item_id:"tools",quantity:1)],effects:[LoseDays(1)]),(id:"camp",label:"Camp until clear",effects:[LoseDays(1),AdjustMorale(1)])]),
    (id:"coyote_cache",text:"Coyotes have scattered a cache of dried meat left by someone else.",weight:2,conditions:[All([MilesAtLeast(1100),FoodBelow(130)])],effects:[],choices:[(id:"gather",label:"Gather what remains",effects:[AdjustFood(11)]),(id:"leave",label:"Leave it untouched",effects:[])]),
    (id:"sulfur_spring",text:"The water smells sharply of sulfur, though the animals drink eagerly.",weight:2,conditions:[AtLandmark("soda_springs")],effects:[],choices:[(id:"move",label:"Move beyond the spring",effects:[LoseDays(1)]),(id:"stay",label:"Camp nearby",effects:[AdjustMorale(-1)])]),
    (id:"wagon_wake",text:"A wheel wake in the mud points to a newer road around the hill.",weight:2,conditions:[All([Weather(Rain),MilesAtLeast(500)])],effects:[],choices:[(id:"follow",label:"Follow the newer road",effects:[SetFlag("new_road"),Schedule(event_id:"new_road_ford",days:2)]),(id:"stay",label:"Stay on the old road",effects:[LoseDays(1)])]),
    (id:"new_road_ford",text:"The newer road reaches a firm, shallow ford before the evening rain.",weight:0,conditions:[Flag("new_road")],effects:[ClearFlag("new_road"),AdjustMorale(3)],choices:[]),
    (id:"mountain_goat",text:"A mountain goat watches from a shelf above the pass.",weight:1,conditions:[All([MilesAtLeast(1500),Weather(Clear)])],effects:[],choices:[(id:"watch",label:"Watch it climb",effects:[AdjustMorale(2)]),(id:"hunt",label:"Take a shot",conditions:[InventoryAtLeast(item_id:"ammunition",quantity:2)],effects:[AdjustItem(item_id:"ammunition",quantity:-2),AdjustFood(14)])]),
    (id:"stolen_spoon",text:"A spoon is missing after strangers shared your noon fire.",weight:1,conditions:[Always],effects:[],choices:[(id:"ask",label:"Ask after it",effects:[AdjustMorale(-1)]),(id:"forget",label:"Forget the spoon",effects:[AdjustMorale(1)])]),
    (id:"bitter_wind",text:"A bitter wind finds every gap in the wagon cover.",weight:2,conditions:[Any([Weather(Cold),Weather(Snow)])],effects:[],choices:[(id:"seal",label:"Seal the cover",conditions:[InventoryAtLeast(item_id:"clothing",quantity:1)],effects:[AdjustItem(item_id:"clothing",quantity:-1),AdjustMorale(2)]),(id:"endure",label:"Endure the wind",effects:[InflictAilment("pneumonia")])]),
    (id:"fort_blacksmith",text:"A fort blacksmith can reset a warped tire before the road worsens.",weight:2,conditions:[AtLandmark("fort_boise")],effects:[],choices:[(id:"pay",label:"Pay the smith",conditions:[CashAtLeast(500)],effects:[AdjustCash(-500),AdjustMorale(2)]),(id:"wait",label:"Wait for tools",effects:[LoseDays(1)])]),
    (id:"ash_cloud",text:"Ash from a distant grass fire dims the afternoon sun.",weight:2,conditions:[All([Season(Summer),Weather(Hot)])],effects:[],choices:[(id:"cover",label:"Cover the supplies",effects:[AdjustFood(-3)]),(id:"move",label:"Move fast",effects:[AdjustMorale(-2)])]),
    (id:"loose_shoe",text:"An ox has thrown a shoe on stony ground.",weight:2,conditions:[MilesAtLeast(750)],effects:[],choices:[(id:"fit",label:"Fit a spare shoe",conditions:[InventoryAtLeast(item_id:"tools",quantity:1)],effects:[LoseDays(1)]),(id:"rest",label:"Rest the ox",effects:[LoseDays(1),AdjustMorale(1)])]),
    (id:"cabin_guest",text:"A widow at a trail cabin offers coffee and news of the road ahead.",weight:2,conditions:[All([MilesAtLeast(300),Season(Autumn)])],effects:[],choices:[(id:"visit",label:"Accept her coffee",effects:[AdjustMorale(3)]),(id:"go",label:"Thank her and go",effects:[])]),
    (id:"wind_damaged_flour",text:"A sudden gust overturns an open flour sack at supper.",weight:2,conditions:[Weather(Storm)],effects:[],choices:[(id:"save",label:"Save what you can",effects:[AdjustFood(-5)]),(id:"discard",label:"Discard the flour",effects:[AdjustFood(-20)])]),
    (id:"short_grass",text:"The grass is cropped short where too many teams have camped.",weight:2,conditions:[All([Season(Summer),MilesAtLeast(600)])],effects:[],choices:[(id:"move",label:"Move farther on",effects:[LoseDays(1)]),(id:"stay",label:"Stay and feed grain",effects:[AdjustFood(-8),AdjustMorale(1)])]),
    (id:"porcupine",text:"A porcupine has chewed the leather lashings on a food chest.",weight:2,conditions:[All([Trail("oregon"),MilesAtLeast(1300)])],effects:[],choices:[(id:"repair",label:"Repair lashings",conditions:[InventoryAtLeast(item_id:"clothing",quantity:1)],effects:[AdjustItem(item_id:"clothing",quantity:-1)]),(id:"pack",label:"Repack the chest",effects:[LoseDays(1)])]),
    (id:"winter_sun",text:"A rare winter sun warms the camp at midday.",weight:1,conditions:[All([Season(Winter),Weather(Clear)])],effects:[],choices:[(id:"wash",label:"Wash clothes",effects:[AdjustMorale(3)]),(id:"travel",label:"Travel while clear",effects:[])]),
    (id:"medicine_peddler",text:"A peddler offers a sealed medicine kit beside the road.",weight:2,conditions:[CashAtLeast(1500)],effects:[],choices:[(id:"buy",label:"Buy medicine",conditions:[CashAtLeast(1500)],effects:[AdjustCash(-1500),AdjustItem(item_id:"medicine",quantity:1)]),(id:"pass",label:"Pass the peddler",effects:[])]),
    (id:"boggy_meadow",text:"The meadow grass hides a bog beneath the wagon path.",weight:3,conditions:[All([Weather(Rain),MilesAtLeast(900)])],effects:[],choices:[(id:"probe",label:"Probe the ground",effects:[LoseDays(1)]),(id:"rush",label:"Rush through",effects:[AdjustFood(-9),AdjustMorale(-3)])]),
    (id:"dry_lightning",text:"Lightning flashes beyond the hills without a drop of rain.",weight:2,conditions:[All([Season(Summer),Weather(Hot)])],effects:[],choices:[(id:"watch",label:"Keep a fire watch",effects:[AdjustMorale(-1)]),(id:"sleep",label:"Sleep as usual",effects:[AdjustMorale(-2)])]),
    (id:"bitter_coffee",text:"The last coffee grounds taste bitter, but wake the weary party.",weight:1,conditions:[MoraleBelow(45)],effects:[],choices:[(id:"brew",label:"Brew the coffee",effects:[AdjustMorale(3)]),(id:"save",label:"Save the grounds",effects:[AdjustMorale(1)])]),
    (id:"plank_ford",text:"A few loose planks offer a crossing over a muddy side channel.",weight:2,conditions:[Weather(Rain)],effects:[],choices:[(id:"lay",label:"Lay the planks",conditions:[InventoryAtLeast(item_id:"tools",quantity:1)],effects:[LoseDays(1)]),(id:"ford",label:"Ford the channel",effects:[AdjustFood(-6)])]),
    (id:"trail_school",text:"A teacher gathers children from three wagons for an hour of lessons.",weight:1,conditions:[Season(Spring)],effects:[],choices:[(id:"stay",label:"Stay for lessons",effects:[LoseDays(1),AdjustMorale(3)]),(id:"go",label:"Keep the schedule",effects:[])]),
    (id:"old_trail_marker",text:"A carved cottonwood points west, but its arrow has weathered crooked.",weight:2,conditions:[All([MilesAtLeast(400),Weather(Rain)])],effects:[],choices:[(id:"verify",label:"Verify the road",effects:[LoseDays(1)]),(id:"trust",label:"Trust the arrow",effects:[AdjustMorale(-2)])]),
    (id:"mormon_hymn",text:"A Mormon pioneer train shares a hymn at the edge of camp.",weight:2,conditions:[Trail("mormon")],effects:[],choices:[(id:"join",label:"Join the hymn",effects:[AdjustMorale(4)]),(id:"rest",label:"Rest quietly",effects:[AdjustMorale(1)])]),
    (id:"sierra_snowpack",text:"Packed snow narrows the Sierra road to one wagon width.",weight:3,conditions:[All([Trail("california"),MilesAtLeast(1750),Any([Season(Autumn),Season(Winter)])])],effects:[],choices:[(id:"shovel",label:"Shovel the road",conditions:[InventoryAtLeast(item_id:"tools",quantity:1)],effects:[LoseDays(1)]),(id:"wait",label:"Wait for thaw",effects:[LoseDays(2)])]),
    (id:"humboldt_reeds",text:"Tall reeds along the Humboldt hide a patch of good grazing.",weight:2,conditions:[All([Trail("california"),AtLandmark("humboldt")])],effects:[],choices:[(id:"graze",label:"Let oxen graze",effects:[LoseDays(1),AdjustMorale(2)]),(id:"go",label:"Keep moving",effects:[])]),
    (id:"salt_desert_glare",text:"White salt throws the noon sun into every eye.",weight:3,conditions:[All([Trail("california"),AtLandmark("salt_desert"),Weather(Hot)])],effects:[],choices:[(id:"shade",label:"Travel at dusk",effects:[LoseDays(1)]),(id:"drive",label:"Drive at noon",effects:[InflictAilment("heat_stroke"),AdjustMorale(-2)])]),
    (id:"echo_canyon_stone",text:"A stone falls from Echo Canyon and dents the wagon side.",weight:2,conditions:[All([Trail("mormon"),AtLandmark("echo_canyon")])],effects:[],choices:[(id:"inspect",label:"Inspect the wagon",effects:[LoseDays(1)]),(id:"go",label:"Move through",effects:[AdjustFood(-4)])]),
    (id:"walla_walla_advice",text:"At Fort Walla Walla, a trader advises waiting for the river wind to ease.",weight:2,conditions:[AtLandmark("fort_walla_walla")],effects:[],choices:[(id:"wait",label:"Wait for wind",effects:[LoseDays(1),AdjustMorale(1)]),(id:"go",label:"Leave at once",effects:[AdjustMorale(-2)])]),
    (id:"snake_river_drift",text:"Driftwood gathers along the Snake River bank after the storm.",weight:2,conditions:[All([AtLandmark("snake_river"),Weather(Storm)])],effects:[],choices:[(id:"gather",label:"Gather dry wood",effects:[AdjustMorale(2)]),(id:"leave",label:"Leave the bank",effects:[])]),
    (id:"independence_rock_name",text:"Someone offers charcoal so each traveler may leave a name on Independence Rock.",weight:1,conditions:[AtLandmark("independence_rock")],effects:[],choices:[(id:"write",label:"Leave a name",effects:[AdjustMorale(3)]),(id:"pass",label:"Pass the rock",effects:[])]),
    (id:"south_pass_breeze",text:"A cool breeze at South Pass carries the first smell of pine.",weight:1,conditions:[AtLandmark("south_pass")],effects:[AdjustMorale(2)],choices:[(id:"rest",label:"Rest at the pass",effects:[LoseDays(1),AdjustMorale(1)]),(id:"go",label:"Start downhill",effects:[])]),
    (id:"dalles_boatman",text:"A boatman at The Dalles offers news of a calm stretch below the rapids.",weight:2,conditions:[AtLandmark("the_dalles")],effects:[],choices:[(id:"pay",label:"Pay for advice",conditions:[CashAtLeast(400)],effects:[AdjustCash(-400),AdjustMorale(2)]),(id:"go",label:"Keep your own counsel",effects:[])]),
    (id:"willamette_orchard",text:"An orchard near the valley offers fallen apples after your long journey.",weight:1,conditions:[AtLandmark("willamette")],effects:[],choices:[(id:"gather",label:"Gather apples",effects:[AdjustFood(18),AdjustMorale(3)]),(id:"rest",label:"Rest in the shade",effects:[AdjustMorale(3)])]),
    (id:"cold_rain",text:"Cold rain blows sideways through the morning camp.",weight:3,conditions:[All([Weather(Rain),Season(Autumn)])],effects:[],choices:[(id:"wait",label:"Wait it out",effects:[LoseDays(1)]),(id:"march",label:"March in rain",effects:[InflictAilment("pneumonia")])]),
    (id:"shared_tools",text:"A wagonmaker asks to borrow your tools for an axle repair.",weight:2,conditions:[InventoryAtLeast(item_id:"tools",quantity:1)],effects:[],choices:[(id:"lend",label:"Lend the tools",effects:[SetFlag("tools_lent"),Schedule(event_id:"tools_returned",days:2)]),(id:"keep",label:"Keep the tools",effects:[AdjustMorale(-1)])]),
    (id:"tools_returned",text:"The wagonmaker returns your tools sharpened and leaves a spare spoke.",weight:0,conditions:[Flag("tools_lent")],effects:[ClearFlag("tools_lent"),AdjustMorale(3)],choices:[]),
