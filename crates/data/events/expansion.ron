    (id:"dust_lung",text:"Fine dust coats every cup and makes the youngest child cough.",weight:3,conditions:[All([Season(Summer),Weather(Hot)])],effects:[],choices:[(id:"camp",label:"Camp early",effects:[LoseDays(1),AdjustMorale(1)]),(id:"drive",label:"Drive through",effects:[InflictAilment("whooping_cough")])]),
