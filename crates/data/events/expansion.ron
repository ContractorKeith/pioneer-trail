    (id:"lark_nest",text:"A meadowlark nest lies in the wagon ruts with three speckled eggs.",weight:2,conditions:[Season(Spring)],effects:[],choices:[(id:"leave",label:"Leave the nest",effects:[AdjustMorale(2)]),(id:"take",label:"Take the eggs",effects:[AdjustFood(4)])]),
