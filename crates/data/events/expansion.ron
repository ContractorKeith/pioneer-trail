    (id:"sore_feet",text:"Long days have raised raw blisters on a party member's heels.",weight:3,conditions:[All([MilesAtLeast(300),MoraleBelow(60)])],effects:[],choices:[(id:"rest",label:"Rest the feet",effects:[LoseDays(1),AdjustMorale(2)]),(id:"wrap",label:"Wrap them tight",conditions:[InventoryAtLeast(item_id:"clothing",quantity:1)],effects:[AdjustItem(item_id:"clothing",quantity:-1)])]),
