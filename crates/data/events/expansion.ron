[
    (id:"prairie_mirage",text:"Heat makes a blue lake shimmer beyond the grass, but the ground there is dry.",weight:3,conditions:[All([Season(Summer),Weather(Hot),FoodBelow(180)])],effects:[],choices:[(id:"shade",label:"Rest in shade",effects:[LoseDays(1),AdjustMorale(2)]),(id:"press",label:"Keep moving",effects:[AdjustMorale(-3),InflictAilment("heat_stroke")])]),
