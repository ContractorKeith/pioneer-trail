[
    (id:"dialogue_001",text:"Mara Vail: I scour the coffee pot with sand before breakfast; a greasy rim turns every cup sour.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_002",text:"Mara Vail: Put those cloths on the wagon rail. By noon the Kansas sun will dry them, or spoil them for good.",landmark_id:Some("kansas_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_003",text:"Mara Vail: I save bacon drippings in a corked jar; they mend a thin supper when flour is all we have.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_004",text:"Mara Vail: The pot stays on until it boils again. Let the drivers complain; the little ones are sick.",landmark_id:Some("big_blue"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_005",text:"Mara Vail: I keep a pinch of tea for the person who cannot keep breakfast down; hot water alone feels like care.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_006",text:"Mara Vail: Green River will have our flour if we leave it loose. Eat the hard cakes now and spare the sack.",landmark_id:Some("green_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_007",text:"Mara Vail: I count beans into each pot instead of pouring from the sack; a careless hand can lose a week of meals.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_008",text:"Mara Vail: These apple peels came from our last barrel. Tonight they go in the oats, and nobody may call them scraps.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_009",text:"Mara Vail: I make broth from every bone after a hard day; tired people need salt more than fine cooking.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_010",text:"Mara Vail: Move that milk pail from the tent door. At Fort Kearney, flies arrive before the soldiers do.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_011",text:"Mara Vail: I wrap the bread in canvas, never loose paper; prairie dust finds every crack in a wagon.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_012",text:"Mara Vail: Hold your plate near the coals first. Porridge looks less fearsome when the tin is not frosted.",landmark_id:None,seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_013",text:"Mara Vail: I put the youngest child beside me at supper when grief is fresh; silence tastes less bitter there.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_014",text:"Mara Vail: Look at those hands. The dust has cut them worse than a knife; bring salt and warm water.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_015",text:"Mara Vail: I keep a covered cup for the driver; he forgets to drink until his voice turns thin.",landmark_id:Some("salt_desert"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_016",text:"Mara Vail: A mouse has found the meal sack. If you see flour on the boards, tell me before the mice invite cousins.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_017",text:"Mara Vail: I stir the pot slowly on windy evenings, because ashes in stew make everyone cross.",landmark_id:Some("chimney_rock"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_018",text:"Mara Vail: Tomorrow we leave before daylight, so breakfast is already by the fire. Do not mistake it for supper.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_019",text:"Ephraim Cole: I test a ford with a pole upstream of the wagons; the quiet water often hides the deeper cut.",landmark_id:Some("kansas_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_020",text:"Ephraim Cole: See the cottonwood leaves turning downstream? Big Blue is rising, though the bank looks harmless yet.",landmark_id:Some("big_blue"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_021",text:"Ephraim Cole: I never trust a pale line of stones under brown water; it may be a bar, or it may be a snag.",landmark_id:Some("green_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_022",text:"Ephraim Cole: Snake River turned a wagon sideways here last spring. Keep the tongue downstream and your people uphill.",landmark_id:Some("snake_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_023",text:"Ephraim Cole: I mark a safe crossing with willow switches, then pull them when our train is through.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_024",text:"Ephraim Cole: You are thirsty, I know. Still, draw upstream of camp; horses and wash water have their own places.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_025",text:"Ephraim Cole: I listen for stones rolling beneath the current at night; that sound means the water is climbing.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_026",text:"Ephraim Cole: A shallow draw drowned a mule near Laramie once. Rain had fallen in hills none of us could see.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_027",text:"Ephraim Cole: I wet the wagon brakes before a steep riverbank; dry wood grabs too late when wheels begin to slide.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_028",text:"Ephraim Cole: Bare feet in the Kansas are a poor bargain. The riverbed keeps hooks, glass, and stones for fools.",landmark_id:Some("kansas_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_029",text:"Ephraim Cole: I fill every canteen before the road leaves a river, even when the next water is promised close.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_030",text:"Ephraim Cole: That foam caught in the grass is last night's water mark. Snake River was a different animal at dawn.",landmark_id:Some("snake_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_031",text:"Ephraim Cole: I keep the children on the high bank until every ox is unyoked; a loose team is danger enough.",landmark_id:Some("big_blue"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_032",text:"Ephraim Cole: Rope goes around the bolster, not the axle. I learned that after an axle spun a rescue rope into a noose.",landmark_id:Some("green_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_033",text:"Ephraim Cole: I taste the Humboldt only to spit it out; good water has no need to prove itself that way.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_034",text:"Ephraim Cole: Camp above the crossing tonight. By morning, twenty pairs of boots will have muddied the lower water.",landmark_id:Some("fort_boise"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_035",text:"Ephraim Cole: I would rather lose an afternoon than a wagon, and a river has never argued otherwise.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_036",text:"Nell Grant: Caleb says six times seven is forty-one. The wheels jolt his slate, but I suspect the road is innocent.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_037",text:"Nell Grant: I tell my boys the next hill is not a promise, only the next hill; that keeps them from counting miles aloud.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_038",text:"Nell Grant: Turn your coat collar over. I stitched your name there, though I hope no stranger ever needs to read it.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_039",text:"Nell Grant: I save my daughter's letters under the bedding; she writes to a grandmother who may never see them.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_040",text:"Nell Grant: No one is too small for kindling. The boys complain, then race back with twice what I asked for.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_041",text:"Nell Grant: I trade a story for a spoonful of medicine when fever makes a child refuse every remedy.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_042",text:"Nell Grant: Name three things you see, children: kettle, mule, moon. Now name one thing worse than this wind.",landmark_id:Some("south_pass"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_043",text:"Nell Grant: I cut old shirts into strips for scraped knees, because grass does not care how fine a child's boots are.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_044",text:"Nell Grant: The eastbound rider waved back, so my youngest says Grandmother must be only two hills away.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_045",text:"Nell Grant: I keep a little flour for paste, so torn school pages may travel farther than their readers do.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_046",text:"Nell Grant: Make room in the middle. Annie sleeps there tonight; the Winter Quarters wind finds every edge of canvas.",landmark_id:Some("winter_quarters"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_047",text:"Nell Grant: I do not hide a death from the children; I give them a task and let them say the name.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_048",text:"Nell Grant: We lost time today, not our manners. The hymn goes slowly, and the children still get their verse.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_049",text:"Nell Grant: I split one biscuit three ways if I must, but I never let the children see the empty flour sack.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_050",text:"Nell Grant: That doll is carrying seed corn, not a baby. We will plant it when the valley has a proper roof over us.",landmark_id:Some("willamette"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_051",text:"Nell Grant: I ask my son to read the trail signs aloud; a boy who reads a sign walks with his head up.",landmark_id:Some("fort_bridger"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_052",text:"Nell Grant: Sunday means the blue ribbon, even in a wagon camp. Children need a day that does not look like Tuesday.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_053",text:"Orson Pike: I tap every wheel spoke with my knife handle; a dull answer tells me which one is loosening.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_054",text:"Orson Pike: Smell that? A hub is getting hot. Better grease it here than watch it smoke beyond Fort Kearney.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_055",text:"Orson Pike: I carry split hickory under the seat, for a wagon never breaks where there is a timber stand.",landmark_id:Some("salt_desert"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_056",text:"Orson Pike: Hear that new squeak? It is asking for grease, not an axle. Let us be polite while it is cheap.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_057",text:"Orson Pike: I use rawhide wet, then let it shrink around a cracked reach; it will hold until the next fort.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_058",text:"Orson Pike: Flour comes off before Blue Mountain's descent. A light wagon hears its brake better than a full one.",landmark_id:Some("blue_mountains"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_059",text:"Orson Pike: I keep the spare wheel dry under canvas, because wet fellies swell and crack at the worst time.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_060",text:"Orson Pike: Put a rag between those irons tonight. The road shakes bolts loose without letting them chatter all night too.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_061",text:"Orson Pike: I mend a harness with square stitches, never long ones; long stitches tear like paper under a team.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_062",text:"Orson Pike: Everybody checks the wheels after Snake River. I check the kingbolt, where the mud hides its mischief.",landmark_id:Some("snake_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_063",text:"Orson Pike: I keep a wedge beside the brake; one crooked wheel can make a camp of the whole train.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_064",text:"Orson Pike: That canvas patch was once a flour sack. The boot was wired shut at Fort Hall and still walks.",landmark_id:Some("fort_hall"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_065",text:"Orson Pike: I put the heavy tools low and forward; a wagon that topples teaches no useful lesson.",landmark_id:Some("echo_canyon"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_066",text:"Orson Pike: Set the brake shoe before the Sierra storm comes. Wet ground gives a rolling wagon no manners.",landmark_id:Some("sierra"),seasons:[Spring,Summer,Autumn],state_tags:[]),
    (id:"dialogue_067",text:"Orson Pike: I ask for payment in nails before coins; nails are the only money a broken wagon accepts.",landmark_id:Some("fort_bridger"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["wealthy"]),
    (id:"dialogue_068",text:"Orson Pike: Do not throw that harness away. The leather is done, but those buckles will outlive three more straps.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_069",text:"Orson Pike: I can make a wheel run crooked for ten miles, but I cannot make it safe; those are different jobs.",landmark_id:Some("south_pass"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_070",text:"Orson Pike: Tallow the saw before that green wood. Otherwise the blade sticks and I say things children should not hear.",landmark_id:Some("fort_boise"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_071",text:"Clara Wynn: I keep my mother's thimble in my apron pocket, though I use a rougher one for wagon mending.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_072",text:"Clara Wynn: Shake that blanket farther from the fire. We have enough prairie in camp without breathing another garden bed.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_073",text:"Clara Wynn: I pin the wash to the wagon bows when rain threatens, so the wind does half the drying.",landmark_id:Some("chimney_rock"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_074",text:"Clara Wynn: Who has only one sock? Speak now. By noon that missing one becomes a blister and then my work.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_075",text:"Clara Wynn: I fold the best quilt inward when we cross water, because memories weigh more when they are soaked.",landmark_id:Some("green_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_076",text:"Clara Wynn: Onion skins make a good dye. A patched sleeve need not announce itself from the next wagon.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_077",text:"Clara Wynn: I put dry grass under the bedrolls, so the cold ground does not climb into our bones.",landmark_id:Some("south_pass"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_078",text:"Clara Wynn: This blue scrap is for Annie's doll. A gray camp can spare one bright thing, can it not?",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_079",text:"Clara Wynn: I wash a cut with cooled tea when no clean water is near; it stings, but dirt stings longer.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_080",text:"Clara Wynn: We leave Fort Hall late if we must. These bedrolls stay out until the damp leaves them.",landmark_id:Some("fort_hall"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_081",text:"Clara Wynn: I keep the family Bible wrapped in oilcloth, beside the sewing needles and nowhere near the flour.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_082",text:"Clara Wynn: No, I will not trade the ribbon for coffee. We have coffee, and I am keeping one useless pretty thing.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["wealthy"]),
    (id:"dialogue_083",text:"Clara Wynn: I save the candle ends for storm nights, when a little light keeps the tent from feeling like a grave.",landmark_id:Some("blue_mountains"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_084",text:"Clara Wynn: Mind the stone, it is warm. Tuck it by your feet and do not tell your brother it is better than his.",landmark_id:Some("winter_quarters"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_085",text:"Clara Wynn: I keep spare laces in my hatband, because a good boot is useless with its tongue flapping open.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_086",text:"Clara Wynn: Mrs. Hale lent us two spoons and a pan at Walla Walla. I wrote it down, lest kindness become a quarrel.",landmark_id:Some("fort_walla_walla"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_087",text:"Clara Wynn: I lay out tomorrow's clothes before dark, because hurried hands forget mittens and medicine alike.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_088",text:"Clara Wynn: Ox bells do not wake me now. A child saying home in the dark still does, even here near Willamette.",landmark_id:Some("willamette"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_089",text:"Jon Bell: I water the oxen before I drink, because they pull the water wagon as well as the load.",landmark_id:Some("salt_desert"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_090",text:"Jon Bell: Hold the lantern low. There is a pebble between his toes, and that pebble thinks it owns three days.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_091",text:"Jon Bell: I never yoke a sore ox beside the strongest one; the strong fellow will pull him lame.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_092",text:"Jon Bell: The captain wants miles; these collars want loosening. I know which complaint will still matter tomorrow.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_093",text:"Jon Bell: I carry bran for the weak ox, not as a treat but as a reason for him to rise again.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_094",text:"Jon Bell: Take the team wide of that badger hole. One broken leg can turn a wagon into a firewood pile by moonlight.",landmark_id:Some("independence_rock"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_095",text:"Jon Bell: I rub a mule's ears when flies are thick; a bothered mule saves his temper for the harness.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_096",text:"Jon Bell: Hobble them where they can see the fire. Even a steady ox imagines better grass when the dark comes.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_097",text:"Jon Bell: I keep a bell on the lead ox and a hand on its rope at riverbanks; livestock likes a bad idea first.",landmark_id:Some("snake_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_098",text:"Jon Bell: Give them grain before the Sierra climb. Grass does not carry a mountain, and neither does wishing.",landmark_id:Some("sierra"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_099",text:"Jon Bell: I watch the oxen noses in dust storms; when they turn away, I know it is time to make camp.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_100",text:"Jon Bell: The hoof pick around my neck looks foolish until the one in the tool chest is half a mile behind us.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_101",text:"Jon Bell: I do not whip a frightened ox at a crossing; I let the calm one show him where to put his feet.",landmark_id:Some("big_blue"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_102",text:"Jon Bell: Leave the best grass for the milk cow. Empty pails make hungry children louder than a whole team.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_103",text:"Jon Bell: I walk beside a tired team after supper, just to hear if any one of them favors a leg.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_104",text:"Jon Bell: The yokes sleep under canvas tonight. Wet wood will rub a neck raw before noon tomorrow.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_105",text:"Jon Bell: I have buried an ox and paid for another, and I would rather buy feed than repeat that lesson.",landmark_id:Some("fort_bridger"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["wealthy"]),
    (id:"dialogue_106",text:"Eliza Moss: Mr. Dyer gave us two pounds of salt for cloth. There it is in the ledger; friendly does not mean forgotten.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_107",text:"Eliza Moss: I ask to see flour before I offer coffee; a clean sack tells more than a cheerful seller.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_108",text:"Eliza Moss: Needles, salt, and tobacco travel in separate packets. At Bridger, each starts a different kind of talk.",landmark_id:Some("fort_bridger"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_109",text:"Eliza Moss: I never spend the last silver coin on a pretty thing, however much the road has made me want it.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_110",text:"Eliza Moss: Coffee is for trade before Green River, not after. Another wagon can carry dry goods better than ours can swim.",landmark_id:Some("green_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_111",text:"Eliza Moss: I count cartridges twice, once for hunting and once for trouble; the two piles must not meet.",landmark_id:Some("fort_hall"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_112",text:"Eliza Moss: That red blanket is handsome, but show me the weave. Color does not keep a sleeper warm at Winter Quarters.",landmark_id:Some("winter_quarters"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_113",text:"Eliza Moss: I save my smallest coins for ferrymen, because a man at a river seldom has change.",landmark_id:Some("kansas_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_114",text:"Eliza Moss: Ask the Fort Boise clerk what sold out first. Travelers boast; empty shelves do not.",landmark_id:Some("fort_boise"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_115",text:"Eliza Moss: I will barter a spare dress for quinine without regret; fine cloth cannot cool a fever.",landmark_id:Some("fort_walla_walla"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_116",text:"Eliza Moss: I have coin sewn into my petticoat for seed. A new farm begins before the first furrow, I suppose.",landmark_id:Some("willamette"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_117",text:"Eliza Moss: I pay a fair price for a map and then compare it with two others before I trust the ink.",landmark_id:Some("south_pass"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_118",text:"Eliza Moss: No trading from an open wagon in this dust. Half the buyers only want shelter and the rest cannot see the goods.",landmark_id:Some("chimney_rock"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_119",text:"Eliza Moss: I would rather have five sound needles than a pocket full of paper promises.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_120",text:"Eliza Moss: Salt costs less than spoiled meat. I buy it whenever Fort Laramie has it and the hungry look doubtful.",landmark_id:Some("fort_laramie_ca"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_121",text:"Eliza Moss: I keep trade cloth clean and folded; a rumpled bolt makes even good wool look doubtful.",landmark_id:Some("fort_bridger_ca"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_122",text:"Eliza Moss: Take my pencil, not my ledger. A debt without a mark waits quietly until it becomes a quarrel.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_123",text:"Eliza Moss: I measure wealth by useful things after supper: dry shoes, a full kettle, and a sound team.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["wealthy"]),
    (id:"dialogue_124",text:"Abel Finch: Take the south face where it is open. The north side keeps snow longer and its ground stays hard.",landmark_id:Some("south_pass"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_125",text:"Abel Finch: I read wagon ruts for news: deep ones mean rain, wandering ones mean trouble ahead.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_126",text:"Abel Finch: The man calls it a shortcut. Has he walked it in rain? No? Then it is only a story near Bridger.",landmark_id:Some("fort_bridger_ca"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_127",text:"Abel Finch: I watch birds lift from grass before a storm; they know a low place before the wheels do.",landmark_id:Some("big_blue"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_128",text:"Abel Finch: My compass lives in a wool sock. Laugh if you wish; a loose needle has sent families the wrong way.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_129",text:"Abel Finch: I mark bad water in charcoal on the map, then rub it out only after I have seen it twice.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_130",text:"Abel Finch: In this Blue Mountain fog, keep the wagon ahead in sight. Lose the road if you must, not your neighbors.",landmark_id:Some("blue_mountains"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_131",text:"Abel Finch: I look for willow and cottonwood before I promise firewood; a green valley can still be bare.",landmark_id:Some("snake_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_132",text:"Abel Finch: The water walk is longer from that high camp. It is shorter than wading from a flooded tent at dawn.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn],state_tags:[]),
    (id:"dialogue_133",text:"Abel Finch: I have seen fine weather close a mountain pass by sundown, so I keep a day of food uncounted.",landmark_id:Some("sierra"),seasons:[Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_134",text:"Abel Finch: These fresh tracks leave Echo Canyon, but the old trail shows grass in its ruts. Tired people make poor guides.",landmark_id:Some("echo_canyon"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_135",text:"Abel Finch: I put a white rag on thorn branches where the road divides, then fetch it when the last wagon passes.",landmark_id:Some("south_pass_mo"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_136",text:"Abel Finch: We are late, but we wait for sunrise. Guessing east across this desert can make a day disappear.",landmark_id:Some("salt_desert"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_137",text:"Abel Finch: I look for horse tracks near a fort, but I ask whose they are before I follow them.",landmark_id:Some("fort_boise"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_138",text:"Abel Finch: Your map says road. The ground says washout. Give the ground the last word.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_139",text:"Abel Finch: I note every spring that runs in August, because those are the ones worth seeking in a dry year.",landmark_id:Some("soda_springs"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_140",text:"Abel Finch: The short road is dust and the long one has grass. Look at those ribs; I know which road the oxen choose.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_141",text:"Ruth Hale: I start a hymn while I wash bandages; hands work steadier when the tent is not quiet.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_142",text:"Ruth Hale: The willow bark is in the paper twist. Take it with water, then sleep if the camp permits you.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_143",text:"Ruth Hale: I ask the grieving to carry water with me; a full bucket gives the body something honest to do.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_144",text:"Ruth Hale: Start the old tune at Independence Rock. By the second line, even the homesick will be singing into their sleeves.",landmark_id:Some("independence_rock"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["homesick"]),
    (id:"dialogue_145",text:"Ruth Hale: I warm a sick child's hands between mine before I offer broth; cold fingers refuse comfort.",landmark_id:Some("winter_quarters"),seasons:[Autumn,Winter],state_tags:["cold","sick"]),
    (id:"dialogue_146",text:"Ruth Hale: Open the sleeping tent a while after fever. Rain may come, but stale air is no medicine.",landmark_id:Some("fort_hall"),seasons:[Spring,Summer,Autumn],state_tags:["sick"]),
    (id:"dialogue_147",text:"Ruth Hale: I have learned that a cup of water offered without advice is sometimes the best nursing.",landmark_id:Some("soda_springs"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["thirsty"]),
    (id:"dialogue_148",text:"Ruth Hale: One linen scrap from each family, please. After sickness arrives, every scrap has already found a purpose.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_149",text:"Ruth Hale: I sing low beside the fire when snow closes the road, because frightened people hear a loud song as a lie.",landmark_id:Some("sierra"),seasons:[Winter],state_tags:["cold"]),
    (id:"dialogue_150",text:"Ruth Hale: Leave that coffee cup dull. The last clean rag belongs on the fevered brow.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_151",text:"Ruth Hale: I tell a weary mother to sleep first and apologize later; exhaustion makes small sorrows sound like judgments.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_152",text:"Ruth Hale: Give me his full name for my list. The road may forget it after Fort Boise; we will not.",landmark_id:Some("fort_boise"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_153",text:"Ruth Hale: I ask the well ones to fetch wood for the sick; care is easier to bear when it is shared.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_154",text:"Ruth Hale: Here is peppermint for your stomach. Sit by me until the worry passes; you need not explain it.",landmark_id:Some("fort_walla_walla"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["sick"]),
    (id:"dialogue_155",text:"Ruth Hale: I keep children busy gathering smooth stones for a grave; their hands need work when words fail.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_156",text:"Ruth Hale: I cannot promise an easy tomorrow. I can promise we will make breakfast if we have breath and flour.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_157",text:"Ruth Hale: I lace a cold person's boots loosely at night, so swollen feet have room to rest.",landmark_id:Some("south_pass"),seasons:[Autumn,Winter],state_tags:["cold"]),
    (id:"dialogue_158",text:"Micah Reed: The shirt around my hammer was my brother's. The cloth is worn through, but I have not changed it.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_159",text:"Micah Reed: I heat a bent tire slowly and cool it slow, or the iron remembers the crack.",landmark_id:Some("fort_kearney"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_160",text:"Micah Reed: Both wheels are shaking. Spend a day at my fire now, or spend three days beside the road later.",landmark_id:Some("fort_laramie"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["weary"]),
    (id:"dialogue_161",text:"Micah Reed: I save every bent nail in a tin; straightening iron is easier than finding it past Fort Hall.",landmark_id:Some("fort_hall"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_162",text:"Micah Reed: Quiet a moment. That chain is loose. Metal confesses plainly when the camp quits talking over it.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_163",text:"Micah Reed: I set a broken trace with rivets, not hope; hope may travel with us, but it will not pull an ox.",landmark_id:Some("fort_bridger"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_164",text:"Micah Reed: My cold chisel rides under my coat in rain. Rust starts its work before the wet leaves your hands.",landmark_id:Some("the_dalles"),seasons:[Spring,Summer,Autumn],state_tags:[]),
    (id:"dialogue_165",text:"Micah Reed: I mend pots for hungry families first; a cracked skillet turns good flour into a poor supper.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_166",text:"Micah Reed: After my brother died, I hammered until dawn. The empty tent was louder when I stopped.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["grieving"]),
    (id:"dialogue_167",text:"Micah Reed: I put a new ring on a wheel before a mountain descent; that is not a place for borrowed iron.",landmark_id:Some("blue_mountains"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_168",text:"Micah Reed: Pump the bellows slow, child. The fire has rules, but it will teach you if you listen.",landmark_id:Some("fort_boise"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_169",text:"Micah Reed: I pay for good charcoal when I have coin; green wood smoke makes weak iron and weaker tempers.",landmark_id:Some("fort_walla_walla"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["wealthy"]),
    (id:"dialogue_170",text:"Micah Reed: My file lives in a boot leg. A dull blade turns a small repair into night work, and we are late enough.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:["late"]),
    (id:"dialogue_171",text:"Micah Reed: I have patched a wagon with barrel hoops, mule shoes, and one prayer; the prayer was the weakest part.",landmark_id:Some("echo_canyon"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_172",text:"Micah Reed: One cup at a time on that axle. Pour the whole bucket and you may split metal clean through.",landmark_id:Some("snake_river"),seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
    (id:"dialogue_173",text:"Micah Reed: I sharpen the hunting knife before dawn, not when the deer is down and every hand wants it.",landmark_id:Some("humboldt"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hungry"]),
    (id:"dialogue_174",text:"Micah Reed: A widow asked for a new latch, so she has one. A wagon door ought to close against wind and worry.",landmark_id:Some("willamette"),seasons:[Spring,Summer,Autumn,Winter],state_tags:["hopeful"]),
    (id:"dialogue_175",text:"Micah Reed: I hang my tools in the same order each night, so I know what is missing before the train rolls.",landmark_id:None,seasons:[Spring,Summer,Autumn,Winter],state_tags:[]),
]
